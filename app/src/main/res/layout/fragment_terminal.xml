<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/terminalCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/terminal_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <ScrollView
            android:id="@+id/terminalScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/terminalOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/terminal_fg"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/promptLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~ $"
            android:textColor="@color/accent_teal"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingEnd="6dp" />

        <EditText
            android:id="@+id/terminalInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="command"
            android:textColorHint="@color/on_surface_variant"
            android:textColor="@color/on_surface"
            android:fontFamily="monospace"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/terminalSend"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_run"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

    </LinearLayout>

</LinearLayout>
